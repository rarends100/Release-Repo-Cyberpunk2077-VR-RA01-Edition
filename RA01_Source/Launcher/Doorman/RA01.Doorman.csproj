<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RA01: the doorman - a tiny native DLL named like the XInput file the game asks Windows for, so Windows loads it the moment the game starts (see Doorman.cs). -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RA01: the file name the game imports XInputGetState from. -->
    <AssemblyName>xinput9_1_0</AssemblyName>
  </PropertyGroup>

</Project>
